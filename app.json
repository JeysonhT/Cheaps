{
  "expo": {
    "name": "Cheaps",
    "slug": "Cheaps",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./src/assets/images/cheaps_icon.png",
    "scheme": "cheaps",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jeysonhdev.Cheaps"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-vector-icons/material-icons",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/Inter_28pt-Regular.ttf",
            "./src/assets/fonts/Outfit-Regular.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./src/assets/fonts/Inter_28pt-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Outfit",
                "fontDefinitions": [
                  {
                    "path": "./src/assets/fonts/Outfit-Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./src/assets/fonts/Inter_28pt-Regular.ttf",
              "./src/assets/fonts/Outfit-Regular.ttf"
            ]
          }
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./src/assets/images/guide_1.png",
            "./src/assets/images/guide_2.png",
            "./src/assets/images/guide_3.png",
            "./src/assets/images/guide_4.png",
            "./src/assets/images/guide_5.png",
            "./src/assets/images/guide_6.png",
            "./src/assets/images/logotipo_cheaps.png"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

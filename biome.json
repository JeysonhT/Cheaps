{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"linter": {
		"domains": {
			"react": "recommended",
			"reactNative": "recommended"
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"attributePosition": "multiline",
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 80
	},

	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
